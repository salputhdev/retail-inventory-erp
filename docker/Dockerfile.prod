# Image produksi/staging (ADR-001, Architecture §1.2): PHP-FPM + Nginx terpisah.
# Target: `app` (php-fpm) dan `web` (nginx + aset statis).

# ---- Dasar PHP dengan ekstensi yang dibutuhkan
FROM php:8.5-fpm AS base
COPY --from=ghcr.io/mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/
RUN apt-get update && apt-get install -y --no-install-recommends git unzip \
    && install-php-extensions pdo_pgsql pgsql bcmath intl zip pcntl opcache redis \
    && rm -rf /var/lib/apt/lists/*
RUN { \
      echo 'opcache.enable=1'; \
      echo 'opcache.validate_timestamps=0'; \
      echo 'opcache.memory_consumption=128'; \
      echo 'expose_php=0'; \
    } > /usr/local/etc/php/conf.d/zz-prod.ini
WORKDIR /var/www/html

# ---- Dependensi PHP tanpa paket dev
FROM base AS vendor
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --prefer-dist
COPY . .
RUN composer dump-autoload --no-dev --optimize --no-scripts

# ---- Aset frontend
FROM node:26-slim AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY vite.config.js ./
COPY resources ./resources
COPY public ./public
RUN npm run build

# ---- Aplikasi (php-fpm)
FROM base AS app
COPY --from=vendor /var/www/html /var/www/html
COPY --from=assets /app/public/build /var/www/html/public/build
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache
USER www-data

# ---- Web (nginx) berisi aset statis dari image yang sama
FROM nginx:1.29-alpine AS web
COPY docker/nginx/staging.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public
