# Contoh environment staging. JANGAN isi secret di sini: `make staging-env` membuat .env.staging
# (di-ignore git) dengan nilai acak. Di server nyata, secret hanya ada di environment server (C-04).
APP_NAME="Retail Inventory"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost:8443
APP_LOCALE=id
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=retail_inventory
DB_USERNAME=retail
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=30
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
MAIL_MAILER=log
